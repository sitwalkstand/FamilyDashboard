<div class="calendar-icon-picker">
    <button type="button" class="calendar-icon-trigger" title="Change calendar icon" aria-label="@($"Change calendar icon: {SelectedLabel}")"
            aria-expanded="@_isOpen" @onclick="TogglePicker">
        <i class="@CalendarIconValue.GetCssClass(Icon)" aria-hidden="true"></i>
        <span>@SelectedLabel</span>
        <i class="calendar-icon-edit fa-solid fa-pen-to-square" aria-hidden="true"></i>
    </button>
    @if (_isOpen)
    {
        <div class="calendar-icon-popover">
            <div class="calendar-icon-toolbar">
                <label class="visually-hidden" for="@SearchInputId">Search icons</label>
                <input id="@SearchInputId" class="calendar-icon-search" type="search" placeholder="Search icons..." @bind="_search" @bind:event="oninput" />
                <label class="visually-hidden" for="@StyleSelectId">Filter icon style</label>
                <select id="@StyleSelectId" class="calendar-icon-category" @bind="_style">
                    @foreach (var style in Styles)
                    {
                        <option value="@style">@style</option>
                    }
                </select>
                <button type="button" class="calendar-icon-close" aria-label="Close icon picker" @onclick="ClosePicker">×</button>
            </div>
            <div class="calendar-icon-results" role="listbox" aria-label="Available calendar icons">
                @if (FilteredIcons.Count == 0)
                {
                    <p class="calendar-icon-empty">No icons match this search.</p>
                }
                else
                {
                    <Virtualize TItem="FontAwesomeIconOption[]" Items="@FilteredIconRows" Context="iconRow" ItemSize="55">
                        <div class="calendar-icon-row">
                            @foreach (var icon in iconRow)
                            {
                                <button @key="icon.Value" type="button" class="calendar-icon-option @(Icon == icon.Value ? "selected" : "")"
                                        title="@($"{icon.Label} ({icon.Style})")" aria-label="@($"{icon.Label}, {icon.Style}")" aria-selected="@(Icon == icon.Value)"
                                        @onclick="() => ChooseIcon(icon)">
                                    <i class="@CalendarIconValue.GetCssClass(icon.Value)" aria-hidden="true"></i>
                                    <span>@icon.Label</span>
                                </button>
                            }
                        </div>
                    </Virtualize>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly string _pickerId = $"calendar-icon-{Guid.NewGuid():N}";

    [Parameter]
    public string Icon { get; set; } = "calendar-days";

    [Parameter]
    public EventCallback<string> IconChanged { get; set; }

    private bool _isOpen;
    private string _search = string.Empty;
    private string _style = "All styles";
    private string SearchInputId => $"{_pickerId}-search";
    private string StyleSelectId => $"{_pickerId}-style";

    private static readonly string[] Styles = ["All styles", "Solid", "Regular", "Brands"];

    private IReadOnlyList<FontAwesomeIconOption> FilteredIcons
    {
        get
        {
            var search = _search.Trim();
            return FontAwesomeFreeIconCatalog.Icons
                .Where(icon => _style == "All styles" || icon.Style == _style)
                .Where(icon => string.IsNullOrEmpty(search) ||
                    icon.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    icon.Label.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    icon.SearchTerms.Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
    }

    private ICollection<FontAwesomeIconOption[]> FilteredIconRows => FilteredIcons.Chunk(5).ToList();

    private string SelectedLabel => FontAwesomeFreeIconCatalog.Icons.FirstOrDefault(icon => icon.Value == Icon)?.Label ?? "Calendar";

    private void TogglePicker() => _isOpen = !_isOpen;
    private void ClosePicker() => _isOpen = false;

    private async Task ChooseIcon(FontAwesomeIconOption icon)
    {
        Icon = icon.Value;
        await IconChanged.InvokeAsync(icon.Value);
        _isOpen = false;
        _search = string.Empty;
        _style = "All styles";
    }
}
