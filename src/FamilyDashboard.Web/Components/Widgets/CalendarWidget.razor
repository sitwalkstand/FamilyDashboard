@implements IDisposable
@inject DashboardStateService State
@using Microsoft.AspNetCore.Components
@using FamilyDashboard.Web.Services.Calendar

<div class="widget calendar-widget">
    <div class="calendar-header">
        <h2>@RangeStart.ToString("MMM d") – @RangeEnd.ToString("MMM d, yyyy") <small>@WeeksToDisplay weeks</small></h2>
    </div>
    @if (VisibleCalendars.Any())
    {
        <div class="calendar-legend" aria-label="Calendars">
            @foreach (var calendar in VisibleCalendars)
            {
                <span class="calendar-legend-item" style="--event-color:@calendar.Color">
                    <i class="calendar-legend-icon fa-solid fa-@calendar.Icon" aria-hidden="true"></i>
                    <span>@calendar.CalendarName</span>
                </span>
            }
        </div>
    }
    @if (!Weeks.SelectMany(week => week).Any())
    {
        <div class="loading">No upcoming events</div>
    }
    else
    {
        <div class="calendar-weekdays" aria-hidden="true">
            @foreach (var dayName in DayNames)
            {
                <span>@dayName</span>
            }
        </div>
        <div class="calendar-grid" style="--calendar-week-count:@Weeks.Count">
            @foreach (var week in Weeks)
            {
                @foreach (var day in week)
                {
                    <div class="calendar-day @(day.IsCurrentMonth ? "" : "calendar-day-muted")">
                        <span class="calendar-day-number">@day.Date.Day</span>
                        @foreach (var ev in day.Events)
                        {
                            <div class="calendar-event" style="--event-color:@ev.Color" title="@ev.Title">
                                <i class="calendar-event-icon fa-solid fa-@ev.Icon" aria-hidden="true"></i>
                                <span class="calendar-event-time">@(ev.IsAllDay ? "" : ev.Start.ToString("h:mm tt"))</span>
                                <span class="calendar-event-title">@ev.Title</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.CalendarChanged += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    [Parameter]
    public string CalendarNames { get; set; } = "";

    [Parameter]
    public int WeeksToDisplay { get; set; } = 5;

    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private DateTime RangeStart => DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
    private DateTime RangeEnd => RangeStart.AddDays(Math.Clamp(WeeksToDisplay, 1, 6) * 7 - 1);

    private IReadOnlyList<IReadOnlyList<CalendarDay>> Weeks
    {
        get
        {
            var today = DateTime.Today;
            var gridStart = today.AddDays(-(int)today.DayOfWeek);
            var weekCount = Math.Clamp(WeeksToDisplay, 1, 6);

            var eventsByDate = FilteredEvents
                .GroupBy(calendarEvent => calendarEvent.Start.LocalDateTime.Date)
                .ToDictionary(group => group.Key, group => group.OrderBy(calendarEvent => calendarEvent.Start).ToList());

            return Enumerable.Range(0, weekCount)
                .Select(week => Enumerable.Range(0, 7)
                    .Select(dayOffset =>
                    {
                        var date = gridStart.AddDays(week * 7 + dayOffset);
                        return new CalendarDay(
                            date,
                            date.Month == today.Month,
                            eventsByDate.TryGetValue(date, out var events) ? events : []);
                    })
                    .ToList())
                .ToList();
        }
    }

    private IEnumerable<CalendarEventDto> FilteredEvents
    {
        get
        {
            var selectedNames = CalendarNames
                .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return selectedNames.Length == 0
                ? State.Events
                : State.Events.Where(calendarEvent => selectedNames.Contains(calendarEvent.CalendarName, StringComparer.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<CalendarLegendDto> VisibleCalendars
    {
        get
        {
            var selectedNames = CalendarNames
                .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return State.Calendars
                .Where(calendar => selectedNames.Length == 0 || selectedNames.Contains(calendar.CalendarName, StringComparer.OrdinalIgnoreCase))
                .OrderBy(calendar => calendar.CalendarName, StringComparer.OrdinalIgnoreCase);
        }
    }

    public void Dispose() => State.CalendarChanged -= OnChanged;

    private sealed record CalendarDay(DateTime Date, bool IsCurrentMonth, IReadOnlyList<CalendarEventDto> Events);
}
