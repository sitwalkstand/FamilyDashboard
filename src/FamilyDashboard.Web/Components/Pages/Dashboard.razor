@page "/"
@implements IDisposable
@inject IConfiguration Configuration

<div class="dashboard-stage screen-@_screenIndex">
    @if (_screenIndex == 0)
    {
        <div class="screen-calendar">
            <div class="screen-header">
                <ClockWidget />
                <WeatherWidget />
            </div>
            <CalendarWidget />
        </div>
    }
    else if (_screenIndex == 1)
    {
        <div class="screen-details">
            <div class="details-topline">
                <ClockWidget />
                <div class="details-label">Today at a glance</div>
            </div>
            <WeatherWidget />
            <div class="details-grid">
                <CalendarWidget />
                <div class="details-note">
                    <div class="details-note-title">Family board</div>
                    <div class="details-note-copy">A clear view of the day, the forecast, and what is coming next.</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-photo">
            <PhotoSlideshowWidget />
        </div>

        <div class="dashboard-clock">
            <ClockWidget />
        </div>

        <div class="dashboard-calendar">
            <CalendarWidget />
        </div>

        <div class="dashboard-weather">
            <WeatherWidget />
        </div>
    }
</div>

@code {
    private int _screenIndex;
    private Timer? _screenTimer;

    protected override void OnInitialized()
    {
        var intervalSeconds = Configuration.GetValue("Dashboard:ScreenIntervalSeconds", 60);
        _screenTimer = new Timer(_ =>
        {
            _screenIndex = (_screenIndex + 1) % 3;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(intervalSeconds), TimeSpan.FromSeconds(intervalSeconds));
    }

    public void Dispose() => _screenTimer?.Dispose();
}
