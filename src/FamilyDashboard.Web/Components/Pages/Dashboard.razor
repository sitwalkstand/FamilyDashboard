@page "/"
@implements IDisposable
@inject IConfiguration Configuration
@using FamilyDashboard.Web.Data
@using FamilyDashboard.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject DashboardStateService State

@if (_screens.Count == 0)
{
    <div class="dashboard-stage screen-empty @RotationClass"><div class="loading">No enabled screens configured</div></div>
}
else
{
    var screen = _screens[_screenIndex];
    <div class="dashboard-stage screen-@_screenIndex @RotationClass">
        <div class="configured-screen">
            @foreach (var widget in screen.Widgets.Where(widget => widget.Enabled).OrderBy(widget => widget.DisplayOrder))
            {
                <div class="configured-widget widget-@widget.WidgetType.ToLowerInvariant()" style="@WidgetStyle(widget)">
                    @switch (widget.WidgetType)
                    {
                        case "Clock":
                            <ClockWidget />
                            break;
                        case "Weather":
                            <WeatherWidget Widget="@widget" />
                            break;
                        case "Calendar":
                            <CalendarWidget CalendarNames="@widget.CalendarNames" WeeksToDisplay="@widget.CalendarWeeks" />
                            break;
                        case "Photos":
                            <PhotoSlideshowWidget Widget="@widget" />
                            break;
                        case "SchoolMenu":
                            <SchoolMenuWidget Widget="@widget" />
                            break;
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<DashboardScreen> _screens = [];
    private int _screenIndex;
    private int _rotation;
    private int _elapsedSeconds;
    private Timer? _screenTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadScreens();
        State.ScreensChanged += OnScreensChanged;
        _screenTimer = new Timer(_ => Tick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Admin edits push here over the existing circuit, so the kiosk picks up
    // layout changes without a browser reload.
    private void OnScreensChanged() => InvokeAsync(async () =>
    {
        await LoadScreens();
        StateHasChanged();
    });

    private string RotationClass => _rotation is 90 or 180 or 270 ? $"rotate-{_rotation}" : string.Empty;

    private async Task LoadScreens()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _rotation = await db.Settings.Select(settings => settings.DisplayRotation).FirstOrDefaultAsync();
        _screens = await db.Screens
            .Where(screen => screen.Enabled)
            .Include(screen => screen.Widgets)
            .OrderBy(screen => screen.DisplayOrder)
            .ToListAsync();
        if (_screens.Count > 0)
        {
            _screenIndex = Math.Min(_screenIndex, _screens.Count - 1);
        }
    }

    private void Tick()
    {
        if (_screens.Count == 0)
        {
            return;
        }

        _elapsedSeconds++;
        if (_elapsedSeconds < Math.Max(5, _screens[_screenIndex].DurationSeconds))
        {
            return;
        }

        _elapsedSeconds = 0;
        _screenIndex = (_screenIndex + 1) % _screens.Count;
        InvokeAsync(StateHasChanged);
    }

    private static string WidgetStyle(DashboardWidget widget)
    {
        var x = Math.Clamp(widget.PositionX, 1, 12);
        var y = Math.Clamp(widget.PositionY, 1, 12);
        var width = Math.Clamp(widget.Width, 1, 13 - x);
        var height = Math.Clamp(widget.Height, 1, 13 - y);
        // z-index gives each widget its own stacking context, so layer order holds even when
        // widget content (e.g. the photo's transform animation) would otherwise paint above siblings.
        return $"grid-column: {x} / span {width}; grid-row: {y} / span {height}; z-index: {Math.Max(0, widget.DisplayOrder)};";
    }

    public void Dispose()
    {
        State.ScreensChanged -= OnScreensChanged;
        _screenTimer?.Dispose();
    }
}

