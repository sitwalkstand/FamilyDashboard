        widget.WeatherShowMoonPhase = show;
        widget.WeatherShowWind = show;
        widget.WeatherShowUvIndex = show;
        widget.WeatherShowHumidity = show;
        widget.WeatherShowPressure = show;
        widget.WeatherShowVisibility = show;
    }

    private static int[] WeatherForecastLengths(string mode) => mode == "Hourly" ? [4, 8, 12] : [3, 5, 7];

    private static int NormalizeWeatherForecastLength(string mode, int length)
    {
        var lengths = WeatherForecastLengths(mode);
        return lengths.Contains(length) ? length : lengths[1];
    }

    private static void SetWeatherForecastMode(DashboardWidget widget, string mode)
    {
        widget.WeatherForecastMode = mode;
        widget.WeatherForecastLength = NormalizeWeatherForecastLength(mode, widget.WeatherForecastLength);
    }

    private async Task LoadGoogleCalendars()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _googleConnectedEmail = await db.GoogleCalendarConnections
            .Select(connection => connection.Email)
            .SingleOrDefaultAsync();
        if (_googleConnectedEmail is not null && GoogleCalendarService.IsConfigured)
        {
            try
            {
                _googleCalendars = (await GoogleCalendarService.GetCalendarsAsync()).ToList();
            }
            catch (Google.Apis.Auth.OAuth2.Responses.TokenResponseException exception) when (exception.Error?.Error == "invalid_grant")
            {
                await GoogleCalendarService.DisconnectAsync();
                _googleConnectedEmail = null;
                _googleCalendars = [];
            }
            catch (System.Security.Cryptography.CryptographicException)
            {
                await GoogleCalendarService.DisconnectAsync();
                _googleConnectedEmail = null;
                _googleCalendars = [];
            }
            catch (Exception exception) when (exception is InvalidOperationException or HttpRequestException)
            {
                _photoUploadMessage = $"Google Calendar could not be loaded: {exception.Message}";
            }
        }
    }

    private bool IsGoogleCalendarSelected(string calendarId) =>
        _feeds.Any(feed => feed.SourceType == "Google" && feed.ExternalId == calendarId && feed.Enabled);

    private async Task ToggleGoogleCalendar(GoogleCalendarInfo calendar, bool selected)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var feed = await db.CalendarFeeds.SingleOrDefaultAsync(item =>
            item.SourceType == "Google" && item.ExternalId == calendar.Id);
        if (selected && feed is not null)
        {
            // A feed disabled from the feeds table shows as unselected here; re-enable it rather than ignoring the click.
            feed.Enabled = true;
        }
        else if (selected)
        {
            db.CalendarFeeds.Add(new CalendarFeed
            {
                DisplayName = calendar.Summary,
                SourceType = "Google",
                ExternalId = calendar.Id,
                Color = calendar.BackgroundColor ?? "#3B8BD4",
                Enabled = true
            });
        }
        else if (!selected && feed is not null)
        {
            db.CalendarFeeds.Remove(feed);
        }

        await db.SaveChangesAsync();
        await LoadFeeds();
        await RefreshCalendarNow();
    }

    private async Task AddFeed()
    {
        if (string.IsNullOrWhiteSpace(_newFeed.IcsUrl))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.CalendarFeeds.Add(new CalendarFeed
        {
            DisplayName = string.IsNullOrWhiteSpace(_newFeed.DisplayName) ? "Calendar" : _newFeed.DisplayName,
            IcsUrl = _newFeed.IcsUrl,
            Icon = _newFeed.Icon,
            Color = string.IsNullOrWhiteSpace(_newFeed.Color) ? "#3B8BD4" : _newFeed.Color,
            Enabled = true
        });
        await db.SaveChangesAsync();

        _newFeed = new CalendarFeed();
        await LoadFeeds();
        await RefreshCalendarNow();
    }

    private async Task UpdateCalendarAppearance(CalendarFeed feed, string? icon, string? color)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var savedFeed = await db.CalendarFeeds.FindAsync(feed.Id);
        if (savedFeed is null)
        {
            return;
        }

        if (icon is not null)
        {
            savedFeed.Icon = icon;
        }
        if (color is not null)
        {
            savedFeed.Color = color;
        }

        await db.SaveChangesAsync();
        await LoadFeeds();
        await RefreshCalendarNow();
    }

    private async Task UpdateGoogleCalendarDisplayName(int feedId, string? displayName)
    {
        // Enter and blur can both fire for one edit, and Escape cancels before blur; only the first save counts.
        if (_editingGoogleCalendarFeedId != feedId)
        {
            return;
        }

        _editingGoogleCalendarFeedId = null;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var feed = await db.CalendarFeeds.FindAsync(feedId);
        if (feed is null || feed.SourceType != "Google")
        {
            return;
        }

        var oldName = feed.DisplayName;
        var newName = displayName.Trim();
        if (oldName == newName)
        {
            return;
        }

        feed.DisplayName = newName;

        // Widgets store their selected calendars by display name, so carry the rename over to them.
        var widgets = await db.Widgets.Where(widget => widget.CalendarNames != "").ToListAsync();
        foreach (var widget in widgets)
        {
            var names = ParseCalendarNames(widget.CalendarNames);
            if (names.RemoveAll(name => string.Equals(name, oldName, StringComparison.OrdinalIgnoreCase)) > 0)
            {
                if (!names.Contains(newName, StringComparer.OrdinalIgnoreCase))
                {
                    names.Add(newName);
                }
                widget.CalendarNames = string.Join("|", names);
            }
        }

        await db.SaveChangesAsync();
        await LoadFeeds();
        await LoadScreens();
        State.NotifyScreensChanged();
        await RefreshCalendarNow();
    }

    private void EditGoogleCalendarName(CalendarFeed feed)
    {
        _editingGoogleCalendarFeedId = feed.Id;
        _googleCalendarNameDraft = feed.DisplayName;
        _focusGoogleCalendarNameInput = true;
    }

    private async Task OnGoogleCalendarNameKeyDown(KeyboardEventArgs args, int feedId)
    {
        if (args.Key == "Enter")
        {
            await UpdateGoogleCalendarDisplayName(feedId, _googleCalendarNameDraft);
        }
        else if (args.Key == "Escape")
        {
            _editingGoogleCalendarFeedId = null;
        }
    }

    private async Task UpdateFeedEnabled(CalendarFeed feed, bool enabled)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var savedFeed = await db.CalendarFeeds.FindAsync(feed.Id);
        if (savedFeed is null)
        {
            await LoadFeeds();
            return;
        }

        savedFeed.Enabled = enabled;
        await db.SaveChangesAsync();
        await LoadFeeds();
        await RefreshCalendarNow();
    }

    private async Task Delete(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var feed = await db.CalendarFeeds.FindAsync(id);
        if (feed is not null)
        {
            db.CalendarFeeds.Remove(feed);
            await db.SaveChangesAsync();
        }
        await LoadFeeds();
        await RefreshCalendarNow();
    }

    private async Task RefreshCalendarNow()
    {
        // Fetch and push immediately rather than waiting for CalendarRefreshWorker's
        // next scheduled tick (up to Calendar:RefreshMinutes away), so the dashboard
        // reacts right away to changes made here.
        var lookAheadDays = Configuration.GetValue("Calendar:LookAheadDays", 14);
        var events = await CalendarService.GetUpcomingEventsAsync(
            _feeds.Where(f => f.Enabled), lookAheadDays);
        State.UpdateEvents(events, _feeds.Where(feed => feed.Enabled));
    }
}
