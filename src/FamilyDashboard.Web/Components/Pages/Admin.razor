                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                    }
                                    @mode
                                </button>
                            }
                        </div>
                        @if (SelectedWidget.WeatherForecastMode != "None")
                        {
                            var hourly = SelectedWidget.WeatherForecastMode == "Hourly";
                            <div class="property-section-title">Forecast length</div>
                            <div class="segmented-control" role="group" aria-label="Forecast length">
                                @foreach (var length in WeatherForecastLengths(SelectedWidget.WeatherForecastMode))
                                {
                                    var selected = SelectedWidget.WeatherForecastLength == length;
                                    <button type="button" class="@(selected ? "selected" : "")" aria-pressed="@selected" @onclick="() => SelectedWidget.WeatherForecastLength = length">
                                        @if (selected)
                                        {
                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                        }
                                        @(length)-@(hourly ? "Hour" : "Day")
                                    </button>
                                }
                            </div>
                        }

                        <div class="property-section-title">Precipitation</div>
                        <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowPrecipitationAmount" /> Show the amount of precipitation</label>
                        <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowPrecipitationChance" /> Show the percent chance of precipitation</label>

                        <div class="property-section-title">Condensed view</div>
                        <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherCondensed" /> A smaller, more condensed weather widget</label>
                    }
                    <label>Layer order<input type="number" min="0" @bind="SelectedWidget.DisplayOrder" /></label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="danger-button" @onclick="() => DeleteWidgetFromModal(SelectedWidget.Id)">Remove block</button>
                <span></span>
                <button class="secondary-button" @onclick="CloseWidgetModal">Cancel</button>
                <button @onclick="() => SaveWidgetFromModal(SelectedWidget)">Save changes</button>
            </div>
        </div>
    </div>
}

