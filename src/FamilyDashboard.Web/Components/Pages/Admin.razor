        {
            await LookupWeatherLocation();
        }
    }

    private async Task<bool> LookupWeatherLocation()
    {
        _weatherMessage = null;
        _isLookingUpWeather = true;
        try
        {
            var location = await WeatherService.FindLocationAsync(_weatherLocationQuery);
            if (location is null)
            {
                _weatherMessage = "No location was found. Try a city and state, such as \"Winchester, VA\".";
                return false;
            }

            if (SelectedWidget is null)
            {
                return false;
            }

            SelectedWidget.WeatherLatitude = Math.Round(location.Latitude, 4);
            SelectedWidget.WeatherLongitude = Math.Round(location.Longitude, 4);
            SelectedWidget.WeatherLocationName = location.DisplayName;
            _weatherLocationQuery = location.DisplayName;
            return true;
        }
        catch (HttpRequestException exception)
        {
            _weatherMessage = $"Location lookup failed: {exception.Message}";
            return false;
        }
        finally
        {
            _isLookingUpWeather = false;
        }
    }

