    // Checks the album link before saving and stores it in one canonical form; choosing the photo
    // folder clears it. Returns false (with a message) when the link is not a shared album link.
    private bool ApplyPhotoSource(DashboardWidget widget)
    {
        var settings = widget.PhotoSettings;
        if (!_photoSourceIsAlbum)
        {
            settings.AlbumUrl = string.Empty;
            return true;
        }

        if (!SharedAlbumUrl.TryParse(settings.AlbumUrl, out var link))
        {
            _albumUrlMessage = string.IsNullOrWhiteSpace(settings.AlbumUrl)
                ? "Paste the shared album's public link, or switch the source back to Photo folder."
                : "That isn't an iCloud shared album link. It should look like https://photos.icloud.com/shared/album/031AbCdEfGhIjKlMnOpQrStUv/ or https://www.icloud.com/sharedalbum/#B0aBcDeFgHiJkL.";
            return false;
        }

        settings.AlbumUrl = link.CanonicalUrl;
        _albumUrlAtOpen = settings.AlbumUrl;
        return true;
    }

    private static string AlbumStatusText(AlbumSyncStatus status)
    {
        var album = string.IsNullOrWhiteSpace(status.AlbumName) ? "Shared album" : $"\"{status.AlbumName}\"";
        var synced = status.LastSyncedUtc is { } syncedUtc ? $", last synced {syncedUtc.ToLocalTime():MMM d h:mm tt}" : "";
        var summary = $"{album}: {status.PhotoCount} photo(s) cached{synced}.";
        return status.LastError is null ? summary : $"{summary} Last sync problem: {status.LastError}";
    }

    private async Task OnWeatherLocationKeyDown(KeyboardEventArgs args)
    {
