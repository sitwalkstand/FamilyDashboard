@page "/admin"
@using FamilyDashboard.Web.Data
@using FamilyDashboard.Web.Data.Entities
@using FamilyDashboard.Web.Services
@using FamilyDashboard.Web.Services.Calendar
@using FamilyDashboard.Web.Services.Photos
@using FamilyDashboard.Web.Services.Weather
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ICalendarService CalendarService
@inject IGoogleCalendarService GoogleCalendarService
@inject DashboardStateService State
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject IPhotoService PhotoService
@inject IWeatherService WeatherService
@implements IAsyncDisposable

<div class="admin-page">
<h1>Dashboard admin</h1>

<nav class="admin-tabs" aria-label="Admin sections">
    <button class="admin-tab @(_activeTab == AdminTab.Dashboard ? "active" : "")" @onclick="() => _activeTab = AdminTab.Dashboard">Dashboard</button>
    <button class="admin-tab @(_activeTab == AdminTab.Calendar ? "active" : "")" @onclick="() => _activeTab = AdminTab.Calendar">Calendar</button>
    <button class="admin-tab @(_activeTab == AdminTab.Photos ? "active" : "")" @onclick="() => _activeTab = AdminTab.Photos">Photos</button>
</nav>

@if (_activeTab == AdminTab.Dashboard)
{
<section class="admin-section">
    <div class="editor-toolbar">
        <div>
            <h2>Screen editor</h2>
            <p class="hint">Select a screen, add blocks, then adjust the selected block's position and size. The canvas updates as you edit.</p>
        </div>
        <div class="editor-toolbar-actions">
            <label class="rotation-setting" title="Use this when the monitor is mounted on its side but the kiosk still outputs a landscape picture.">Kiosk rotation
                <select id="display-rotation" @bind="_displayRotation" @bind:after="SaveDisplayRotation">
                    @foreach (var (degrees, label) in DisplayRotations)
                    {
                        <option value="@degrees">@label</option>
                    }
                </select>
            </label>
            <button @onclick="AddScreen">New screen</button>
            <button class="secondary-button" @onclick="SaveAllScreens">Save all</button>
        </div>
    </div>

    @if (_screens.Count == 0)
    {
        <p class="empty-state">No screens configured. Add one to start building your dashboard.</p>
    }
    else
    {
        <nav class="screen-tabs" aria-label="Dashboard screens">
            @foreach (var screen in _screens)
            {
                <button class="screen-tab @(screen.Id == _selectedScreenId ? "active" : "")" @onclick="() => SelectScreen(screen.Id)">
                    <span>@screen.Name</span>
                    <small>@screen.Widgets.Count blocks</small>
                </button>
            }
        </nav>

        @if (SelectedScreen is not null)
        {
            <div class="wysiwyg-editor">
                <aside class="editor-sidebar">
                    <div class="sidebar-heading">
                        <span>Add a block</span>
                        <span class="block-count">@SelectedScreen.Widgets.Count</span>
                    </div>
                    <p class="sidebar-help">Choose a widget to place it on this screen.</p>
                    <div class="block-palette">
                        @foreach (var type in WidgetTypes)
                        {
                            <button class="palette-item" @onclick="() => AddWidget(SelectedScreen, type)">
                                <span class="palette-icon">@WidgetIcon(type)</span>
                                <span>@type</span>
                                <span class="palette-plus">+</span>
                            </button>
                        }
                    </div>
                    <div class="screen-settings">
                        <div class="sidebar-heading">Screen settings</div>
                        <label>Name<input @bind="SelectedScreen.Name" /></label>
                        <label>Rotation order<input type="number" min="0" @bind="SelectedScreen.DisplayOrder" /></label>
                        <label>Display seconds<input type="number" min="5" @bind="SelectedScreen.DurationSeconds" /></label>
                        <label>Display shape
                            <select id="screen-aspect" @bind="SelectedScreen.AspectRatio" @bind:after="() => SaveScreen(SelectedScreen)">
                                @foreach (var (value, label) in AspectRatios)
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        </label>
                        <label class="checkbox-label"><input type="checkbox" @bind="SelectedScreen.Enabled" /> Include in rotation</label>
                        <button @onclick="() => SaveScreen(SelectedScreen)">Save screen</button>
                        <button class="danger-button" @onclick="() => DeleteScreen(SelectedScreen.Id)">Delete screen</button>
                    </div>
                </aside>

                <main class="canvas-area">
                    <div class="canvas-heading">
                        <div><strong>@SelectedScreen.Name</strong><span>Live preview</span></div>
                        <span class="canvas-size">12 x 12 grid · @AspectRatioLabel(SelectedScreen.AspectRatio)</span>
                    </div>
                    @{ var (aspectWidth, aspectHeight) = ParseAspectRatio(SelectedScreen.AspectRatio); }
                    <div class="canvas-frame" style="--aspect-w: @aspectWidth; --aspect-h: @aspectHeight;">
                    <div class="screen-canvas">
                        @for (var row = 1; row <= 12; row++)
                        {
                            @for (var column = 1; column <= 12; column++)
                            {
                                <span class="canvas-cell" style="grid-column:@column;grid-row:@row"></span>
                            }
                        }
                        @foreach (var widget in SelectedScreen.Widgets.Where(widget => widget.Enabled).OrderBy(widget => widget.DisplayOrder))
                        {
                            <div class="canvas-block widget-@widget.WidgetType.ToLowerInvariant() @(widget.Id == _selectedWidgetId ? "selected" : "")"
                                 style="@WidgetStyle(widget)"
                                 data-widget-id="@widget.Id"
                                 data-x="@widget.PositionX"
                                 data-y="@widget.PositionY"
                                 data-w="@widget.Width"
                                 data-h="@widget.Height"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@($"{widget.WidgetType} widget at column {widget.PositionX}, row {widget.PositionY}, {widget.Width} by {widget.Height}")"
                                 @onclick="() => SelectWidget(widget.Id)">
                                <span class="canvas-block-icon">@WidgetIcon(widget.WidgetType)</span>
                                <span>@widget.WidgetType</span>
                                <small>@widget.Width x @widget.Height</small>
                                <span class="widget-hover-actions" @onclick:stopPropagation="true">
                                    <button type="button" title="Edit widget" @onclick="() => OpenWidgetModal(widget.Id)">✎</button>
                                    <button type="button" title="Delete widget" @onclick="() => DeleteWidget(widget.Id)">×</button>
                                </span>
                                  @foreach (var handle in ResizeHandles)
                                  {
                                    <span class="widget-resize-handle resize-@handle.ToString().ToLowerInvariant()" title="Resize widget"
                                        @onclick:stopPropagation="true"></span>
                                  }
                            </div>
                        }
                    </div>
                    </div>
                </main>

                @if (SelectedWidget is { } layoutWidget)
                {
                    <aside class="editor-tip-panel layout-panel">
                        <strong>@layoutWidget.WidgetType layout</strong>
                        <div class="layout-fields">
                            <label>Column<input id="layout-x" type="number" min="1" max="12" @bind="layoutWidget.PositionX" @bind:after="() => SaveWidget(layoutWidget)" /></label>
                            <label>Row<input id="layout-y" type="number" min="1" max="12" @bind="layoutWidget.PositionY" @bind:after="() => SaveWidget(layoutWidget)" /></label>
                            <label>Width<input id="layout-w" type="number" min="1" max="@(13 - layoutWidget.PositionX)" @bind="layoutWidget.Width" @bind:after="() => SaveWidget(layoutWidget)" /></label>
                            <label>Height<input id="layout-h" type="number" min="1" max="@(13 - layoutWidget.PositionY)" @bind="layoutWidget.Height" @bind:after="() => SaveWidget(layoutWidget)" /></label>
                        </div>
                        <p>Drag a block to move it, or drag its edges to resize. With a block selected, arrow keys move it and Shift + arrow keys resize it.</p>
                        <button type="button" class="secondary-button" @onclick="() => OpenWidgetModal(layoutWidget.Id)">Widget settings</button>
                    </aside>
                }
                else
                {
                    <aside class="editor-tip-panel">
                        <span class="property-empty-icon">✦</span>
                        <strong>Live canvas</strong>
                        <p>Drag a block to move it, or drag its edges to resize. Select a block to set its exact position and size.</p>
                    </aside>
                }
            </div>
        }
    }
</section>

}
@if (_activeTab == AdminTab.Calendar)
{
<section class="feed-section">
    <div class="feed-section-heading">
        <div>
            <h2>Calendar feeds</h2>
            <p class="hint">Connected feeds are available to every Calendar block on your screens.</p>
        </div>
        <span class="feed-count">@_feeds.Count connected</span>
    </div>

    @if (_feeds.Count == 0)
    {
        <div class="feed-empty">No calendar feeds yet. Add an ICS feed below to populate Calendar blocks.</div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr><th>Name</th><th>Source</th><th>Icon</th><th>Color</th><th>Enabled</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var feed in _feeds)
                {
                    <tr>
                        <td>
                            @if (feed.SourceType == "Google")
                            {
                                @if (_editingGoogleCalendarFeedId == feed.Id)
                                {
                                    <input class="google-calendar-name-input" value="@_googleCalendarNameDraft"
                                           @ref="_googleCalendarNameInput"
                                           aria-label="Dashboard display name for @feed.DisplayName"
                                           @oninput="args => _googleCalendarNameDraft = args.Value?.ToString() ?? string.Empty"
                                           @onkeydown="args => OnGoogleCalendarNameKeyDown(args, feed.Id)"
                                           @onblur="() => UpdateGoogleCalendarDisplayName(feed.Id, _googleCalendarNameDraft)" />
                                }
                                else
                                {
                                    <button type="button" class="google-calendar-name-trigger" title="Edit dashboard name"
                                            @onclick="() => EditGoogleCalendarName(feed)">@feed.DisplayName</button>
                                }
                            }
                            else
                            {
                                @feed.DisplayName
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(feed.IcsUrl))
                            {
                                <a href="@feed.IcsUrl" target="_blank" rel="noopener noreferrer">Open source</a>
                            }
                            else if (feed.SourceType == "Google" && !string.IsNullOrWhiteSpace(feed.ExternalId))
                            {
                                <a href="@GetGoogleCalendarUrl(feed.ExternalId)" target="_blank" rel="noopener noreferrer">Open Google Calendar</a>
                            }
                        </td>
                        <td>
                            <CalendarIconPicker Icon="@feed.Icon" IconChanged="icon => UpdateCalendarAppearance(feed, icon, null)" />
                        </td>
                        <td><input class="calendar-color-input" type="color" aria-label="Color for @feed.DisplayName" value="@feed.Color"
                                   @onchange="args => UpdateCalendarAppearance(feed, null, args.Value?.ToString())" /></td>
                        <td><input class="calendar-feed-enabled" type="checkbox" checked="@feed.Enabled"
                                   aria-label="Enable @feed.DisplayName" title="Enable @feed.DisplayName"
                                   @onchange="args => UpdateFeedEnabled(feed, args.Value is true)" /></td>
                        <td><button class="danger-button" @onclick="() => Delete(feed.Id)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="feed-form">
        <h3>Add a calendar feed</h3>
        <EditForm Model="_newFeed" OnValidSubmit="AddFeed">
            <div class="feed-form-grid">
                <label>Name<InputText @bind-Value="_newFeed.DisplayName" placeholder="Family calendar" /></label>
                <label>ICS URL<InputText @bind-Value="_newFeed.IcsUrl" placeholder="https://calendar.google.com/calendar/ical/.../basic.ics" /></label>
                <CalendarIconPicker @bind-Icon="_newFeed.Icon" />
                <label>Color<InputText @bind-Value="_newFeed.Color" type="color" /></label>
                <button type="submit">Add calendar</button>
            </div>
        </EditForm>
        <p class="hint">Use the private iCal/ICS address from Google Calendar, Outlook.com, or iCloud. The feed will appear in Calendar blocks after it refreshes.</p>
    </div>
</section>

<section class="feed-section google-calendar-section">
    <div class="feed-section-heading">
        <div>
            <h2>Google Calendar</h2>
            <p class="hint">Connect Google once, then choose the calendars this dashboard can display.</p>
        </div>
        @if (_googleConnectedEmail is not null)
        {
            <span class="feed-count">Connected</span>
        }
    </div>
    @if (!GoogleCalendarService.IsConfigured)
    {
        <div class="feed-empty">Google Calendar is not configured. Create <strong>App_Data/google-oauth.json</strong> with your Google client credentials, then restart.</div>
    }
    else if (_googleConnectedEmail is null)
    {
        <div class="feed-form-grid">
            <span class="hint">Authorize this dashboard with a Google account to list its calendars.</span>
            <a class="button-link" href="/auth/google/start">Connect Google Calendar</a>
        </div>
    }
    else
    {
        <p class="hint">Connected account: @_googleConnectedEmail</p>
        @if (_googleCalendars.Count == 0)
        {
            <p class="modal-note">No calendars were returned by Google.</p>
        }
        else
        {
            <div class="calendar-picker google-calendar-picker">
                @foreach (var calendar in _googleCalendars)
                {
                    <label class="calendar-picker-item">
                        <input type="checkbox" checked="@IsGoogleCalendarSelected(calendar.Id)"
                               @onchange="args => ToggleGoogleCalendar(calendar, args.Value is true)" />
                        <span class="swatch" style="background:@(calendar.BackgroundColor ?? "#3B8BD4")"></span>
                        <span>@calendar.Summary</span>
                    </label>
                }
            </div>
            <p class="hint">Selected calendars are available to every Calendar block and can be filtered per block below.</p>
        }
    }
</section>

}

@if (_activeTab == AdminTab.Photos)
{

<section class="photo-upload-section">
    <div class="feed-section-heading">
        <div>
            <h2>Family photos</h2>
            <p class="hint">Upload JPG, PNG, or WebP images for the Photos widget.</p>
        </div>
        <span class="feed-count">@State.PhotoPaths.Count available</span>
    </div>
    <div class="photo-upload-form">
        <InputFile OnChange="SelectPhotos" multiple accept=".jpg,.jpeg,.png,.webp" />
        <button type="button" @onclick="UploadPhotos" disabled="@(_selectedPhotos.Count == 0 || _isUploadingPhotos)">
            @(_isUploadingPhotos ? "Uploading..." : "Upload photos")
        </button>
    </div>
    @if (_selectedPhotos.Count > 0)
    {
        <p class="hint">@_selectedPhotos.Count photo(s) selected.</p>
    }
    @if (!string.IsNullOrWhiteSpace(_photoUploadMessage))
    {
        <p class="upload-message">@_photoUploadMessage</p>
    }
    @if (State.PhotoPaths.Count == 0)
    {
        <div class="feed-empty">No photos available.</div>
    }
    else
    {
        <div class="photo-library-grid">
            @foreach (var photo in State.PhotoPaths)
            {
                <div class="photo-library-item">
                    <img src="@photo" alt="Uploaded family photo" loading="lazy" />
                    <button type="button" class="danger-button" @onclick="() => RemovePhoto(photo)">Remove</button>
                </div>
            }
        </div>
    }
</section>

}

<footer class="admin-footer">
    Version @BuildInfo.Version
    @if (BuildInfo.BuildDate is { } buildDate)
    {
        <span> · Built @buildDate.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
    }
</footer>

</div>

@if (_isWidgetModalOpen && SelectedWidget is not null)
{
    <div class="modal-backdrop" role="presentation" @onclick="CloseWidgetModal">
        <div class="widget-modal" role="dialog" aria-modal="true" aria-labelledby="widget-modal-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div><span class="modal-icon">@WidgetIcon(SelectedWidget.WidgetType)</span><h2 id="widget-modal-title">Configure @SelectedWidget.WidgetType</h2></div>
                <button class="modal-close" aria-label="Close widget settings" @onclick="CloseWidgetModal">×</button>
            </div>
            <div class="modal-body">
                <div class="modal-settings">
                    @if (SelectedWidget.WidgetType == "Calendar")
                    {
                        <label>Rolling month weeks<input type="number" min="1" max="6" @bind="SelectedWidget.CalendarWeeks" /></label>
                    }
                    <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.Enabled" /> Visible on screen</label>
                    @if (SelectedWidget.WidgetType == "Calendar")
                    {
                        <div class="property-section-title">Calendars to show</div>
                        @if (_feeds.Count == 0)
                        {
                            <div class="modal-note">No calendar feeds are connected yet. Add an ICS feed below.</div>
                        }
                        else
                        {
                            <div class="calendar-picker">
                                @foreach (var feed in _feeds)
                                {
                                    <label class="calendar-picker-item">
                                        <input type="checkbox" checked="@IsCalendarSelected(feed.DisplayName)"
                                               @onchange="args => ToggleCalendar(feed.DisplayName, args.Value is true)" />
                                        <span class="calendar-picker-icon"><i class="@CalendarIconValue.GetCssClass(feed.Icon)" aria-hidden="true"></i></span>
                                        <span class="swatch" style="background:@feed.Color"></span>
                                        <span>@feed.DisplayName</span>
                                        @if (!feed.Enabled)
                                        {
                                            <small>disabled</small>
                                        }
                                    </label>
                                }
                            </div>
                            <div class="modal-note">Leave all calendars unchecked to show every enabled feed.</div>
                        }
                        <button type="button" class="modal-link-button" @onclick="() => _showModalFeedForm = !_showModalFeedForm">
                            @( _showModalFeedForm ? "Hide add calendar" : "+ Add calendar to this widget")
                        </button>
                        @if (_showModalFeedForm)
                        {
                            <div class="modal-feed-form">
                                <label>Name<input @bind="_modalFeed.DisplayName" placeholder="Family calendar" /></label>
                                <label>ICS URL<input @bind="_modalFeed.IcsUrl" placeholder="https://.../calendar.ics" /></label>
                                <CalendarIconPicker @bind-Icon="_modalFeed.Icon" />
                                <label>Color<input @bind="_modalFeed.Color" type="color" /></label>
                                <button type="button" @onclick="AddFeedFromModal">Add and select calendar</button>
                            </div>
                        }
                    }
                    else if (SelectedWidget.WidgetType == "Photos")
                    {
                        var photoSettings = SelectedWidget.PhotoSettings;
                        <div class="property-section-title">Photo source</div>
                        <div class="segmented-control" role="group" aria-label="Photo source">
                            @foreach (var (isAlbum, label) in PhotoSources)
                            {
                                var selected = _photoSourceIsAlbum == isAlbum;
                                <button type="button" class="@(selected ? "selected" : "")" aria-pressed="@selected" @onclick="() => SetPhotoSource(isAlbum)">
                                    @if (selected)
                                    {
                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                    }
                                    @label
                                </button>
                            }
                        </div>
                        @if (_photoSourceIsAlbum)
                        {
                            <label>Shared album link<input placeholder="https://photos.icloud.com/shared/album/031AbCdEfGhIjKlMnOpQrStUv/" @bind="photoSettings.AlbumUrl" @bind:event="oninput" @bind:after="() => _albumUrlMessage = null" /></label>
                            <div class="field-hint">Paste the album's public link from Photos: a <code>photos.icloud.com/shared/album/…</code> link, or an older <code>icloud.com/sharedalbum/#…</code> Public Website link. Photos are cached, so the dashboard keeps showing them if iCloud is unreachable.</div>
                            @if (!string.IsNullOrWhiteSpace(_albumUrlMessage))
                            {
                                <div class="modal-note">@_albumUrlMessage</div>
                            }
                            else if (photoSettings.AlbumUrl == _albumUrlAtOpen && State.GetAlbumStatus(SelectedWidget.Id) is { } albumStatus)
                            {
                                <div class="modal-note">@AlbumStatusText(albumStatus)</div>
                            }
                        }
                        else
                        {
                        <div class="property-section-title">Photo to display</div>
                        @if (State.PhotoPaths.Count == 0)
                        {
                            <div class="modal-note">No uploaded photos are available yet. Upload photos from the Family photos section below.</div>
                        }
                        else
                        {
                            <label class="photo-choice">
                                <input type="radio" name="photo-choice" checked="@string.IsNullOrEmpty(SelectedWidget.PhotoPath)"
                                       @onchange="() => SelectWidgetPhoto(SelectedWidget, string.Empty)" />
                                <span>Slideshow: rotate all photos</span>
                            </label>
                            <div class="photo-picker">
                                @foreach (var photo in State.PhotoPaths)
                                {
                                    <label class="photo-picker-item">
                                        <input type="radio" name="photo-choice" checked="@string.Equals(SelectedWidget.PhotoPath, photo, StringComparison.OrdinalIgnoreCase)"
                                               @onchange="() => SelectWidgetPhoto(SelectedWidget, photo)" />
                                        <img src="@photo" alt="Uploaded family photo" />
                                    </label>
                                }
                            </div>
                        }
                        }

                        <div class="property-section-title">Change photo every</div>
                        <div class="segmented-control" role="group" aria-label="Change photo every">
                            @foreach (var minutes in PhotoWidgetSettings.ChangeIntervalMinuteOptions)
                            {
                                var selected = photoSettings.ChangeIntervalSeconds == minutes * 60;
                                <button type="button" class="@(selected ? "selected" : "")" aria-pressed="@selected" @onclick="() => photoSettings.ChangeIntervalSeconds = minutes * 60">
                                    @if (selected)
                                    {
                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                    }
                                    @minutes min
                                </button>
                            }
                        </div>

                        <div class="property-section-title">Style</div>
                        <div class="segmented-control" role="group" aria-label="Photo style">
                            @foreach (var (style, label) in PhotoStyles)
                            {
                                var selected = photoSettings.Style == style;
                                <button type="button" class="@(selected ? "selected" : "")" aria-pressed="@selected" @onclick="() => photoSettings.Style = style">
                                    @if (selected)
                                    {
                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                    }
                                    @label
                                </button>
                            }
                        </div>

                        <label>Brightness: @photoSettings.Brightness%<input type="range" min="0" max="100" step="5" @bind="photoSettings.Brightness" @bind:event="oninput" /></label>

                        <div class="property-section-title">Options</div>
                        <label class="checkbox-label"><input type="checkbox" @bind="photoSettings.Transitions" /> Cross-fade between photos</label>
                        <label class="checkbox-label"><input type="checkbox" @bind="photoSettings.Vignette" /> Darken the edges (vignette)</label>
                        <label class="checkbox-label"><input type="checkbox" @bind="photoSettings.ClickToRotate" /> Tap or click to show the next photo</label>
                        <div class="weather-suboptions @(_photoSourceIsAlbum ? "" : "disabled")">
                            <label class="checkbox-label"><input type="checkbox" @bind="photoSettings.ShowMeta" disabled="@(!_photoSourceIsAlbum)" /> Show caption, contributor and date <small>shared albums only</small></label>
                            <label class="checkbox-label"><input type="checkbox" @bind="photoSettings.HiRes" disabled="@(!_photoSourceIsAlbum)" /> High resolution <small>largest size iCloud offers</small></label>
                        </div>
                    }
                    else if (SelectedWidget.WidgetType == "Weather")
                    {
                        var showCurrent = SelectedWidget.WeatherShowCurrent;
                        <div class="property-section-title">Location</div>
                        <div class="weather-location-search">
                            <input aria-label="Location" placeholder="Winchester, VA" @bind="_weatherLocationQuery" @bind:event="oninput" @onkeydown="OnWeatherLocationKeyDown" />
                            <button type="button" @onclick="LookupWeatherLocation" disabled="@_isLookingUpWeather">@(_isLookingUpWeather ? "Searching..." : "Find")</button>
                        </div>
                        <div class="field-hint">
                            Enter city, region or zip code. ie. <code>Syracuse, NY</code>, or <code>13215</code>
                            @if (string.IsNullOrEmpty(SelectedWidget.WeatherLocationName))
                            {
                                <br />@($"Currently {SelectedWidget.WeatherLatitude:0.####}, {SelectedWidget.WeatherLongitude:0.####}")
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_weatherMessage))
                        {
                            <div class="modal-note">@_weatherMessage</div>
                        }
                        <label>Temperature unit<select @bind="SelectedWidget.WeatherTemperatureUnit"><option value="fahrenheit">Fahrenheit</option><option value="celsius">Celsius</option></select></label>
                        <label>Refresh minutes<input type="number" min="5" @bind="SelectedWidget.WeatherRefreshMinutes" /></label>

                        <div class="property-section-title">Current conditions</div>
                        <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowCurrent" /> Show the current conditions</label>
                        <div class="weather-suboptions @(showCurrent ? "" : "disabled")">
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowFeelsLike" disabled="@(!showCurrent)" /> "Feels like" temperature <small>ie. "Feels like 72&deg;"</small></label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowSummary" disabled="@(!showCurrent)" /> Short text summary <small>ie. "Sunny this afternoon"</small></label>
                        </div>

                        <div class="property-section-title">
                            Extra info
                            <span class="select-links">
                                <button type="button" @onclick="() => SetWeatherExtraInfo(SelectedWidget, true)">Select all</button> /
                                <button type="button" @onclick="() => SetWeatherExtraInfo(SelectedWidget, false)">None</button>
                            </span>
                        </div>
                        <div class="weather-extra-options">
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowSunriseSunset" /> <i class="fa-solid fa-sun" aria-hidden="true"></i> Sunrise/sunset</label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowHumidity" /> <i class="fa-solid fa-droplet" aria-hidden="true"></i> Humidity</label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowMoonPhase" /> <i class="fa-solid fa-moon" aria-hidden="true"></i> Moon phase</label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowPressure" /> <i class="fa-solid fa-gauge" aria-hidden="true"></i> Pressure</label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowWind" /> <i class="fa-solid fa-wind" aria-hidden="true"></i> Wind</label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowVisibility" /> <i class="fa-solid fa-eye" aria-hidden="true"></i> Visibility</label>
                            <label class="checkbox-label"><input type="checkbox" @bind="SelectedWidget.WeatherShowUvIndex" /> <i class="fa-solid fa-sun" aria-hidden="true"></i> UV Index</label>
                        </div>

                        <div class="property-section-title">Forecast</div>
                        <div class="segmented-control" role="group" aria-label="Forecast">
                            @foreach (var mode in WeatherForecastModes)
                            {
                                var selected = SelectedWidget.WeatherForecastMode == mode;
                                <button type="button" class="@(selected ? "selected" : "")" aria-pressed="@selected" @onclick="() => SetWeatherForecastMode(SelectedWidget, mode)">
                                    @if (selected)
