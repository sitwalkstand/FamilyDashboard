<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Required explicitly on some .NET 10 Blazor Server setups so embedded/static
         component assets resolve correctly under the new SDK build pipeline. -->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <UserSecretsId>familydashboard-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ICS calendar parsing (Google/Outlook/iCloud calendar subscription feeds) -->
    <PackageReference Include="Ical.Net" Version="4.3.1" />

    <!-- Persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Resilience for outbound calls to calendar/weather providers -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.5.0" />
  </ItemGroup>

</Project>
