<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- Required explicitly on some .NET 10 Blazor Server setups so embedded/static
         component assets resolve correctly under the new SDK build pipeline. -->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <UserSecretsId>familydashboard-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="App_Data\google-oauth.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- Stamp the build time into the assembly so the admin page can show it (see BuildInfo). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("o"))</_Parameter2>
    </AssemblyAttribute>
    <EmbeddedResource Include="Components\Widgets\fontawesome-free-icons.json">
      <LogicalName>FamilyDashboard.Web.Components.Widgets.fontawesome-free-icons.json</LogicalName>
    </EmbeddedResource>

    <!-- ICS calendar parsing (Google/Outlook/iCloud calendar subscription feeds) -->
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />

    <!-- Persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Resilience for outbound calls to calendar/weather providers -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

</Project>
